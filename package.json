{
  "name": "ai-agents-pwa-php-mysql-skauting",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && node scripts/build-php.mjs && vite build",
    "preview": "vite preview --host",
    "test": "node scripts/build-php.mjs && vitest run",
    "typecheck": "tsc --noEmit",
    "api": "node scripts/dev-api.mjs",
    "dist": "npm run build && node scripts/build-php.mjs --dist"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
