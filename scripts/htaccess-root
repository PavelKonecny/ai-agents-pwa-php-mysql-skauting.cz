# Nastavení webu (Apache, hosting skauting.cz). Aplikace je statická, API je ve složce api/.
Options -Indexes
DirectoryIndex index.html

# Vždy HTTPS (bez něj nefunguje offline režim, instalace na plochu ani schránka)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Stav automatického nasazení (seznam souborů) není pro veřejnost
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType text/javascript .js .mjs
AddType image/svg+xml .svg

<IfModule mod_headers.c>
  # Service worker a vstupní stránka se nesmí cachovat – jinak se aktualizace nedostanou k uživatelům
  <FilesMatch "^(sw\.js|index\.html|manifest\.webmanifest|registerSW\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Soubory s otiskem v názvu (assets/) jsou neměnné
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
